# =============================================================================
#  .htaccess — extensionless URLs, as ALIASES only.
# -----------------------------------------------------------------------------
#  Typing /admin gets you admin.php. Nothing in the app generates these; every
#  link, form action and redirect still uses the .php form, so this can only ever
#  add a way in — it can't break one.
#
#  WHY SINGLE SEGMENT ONLY (no /add_game/18):
#  Every asset URL in this app is relative and root-less — "templates/light/css/
#  style.css", "icons/favicon-32.png", "js/scripts.js", the thumbnails. At /admin
#  the browser still resolves those against /, so they work untouched. At
#  /add_game/18 the base becomes /add_game/, and the stylesheet, every icon and
#  every thumbnail 404s: the page renders completely unstyled. Path-segment URLs
#  need every one of those made root-absolute first, which is a separate job.
#
#  The whole thing is wrapped in <IfModule> so a host without mod_rewrite serves
#  the site normally instead of returning 500.
# =============================================================================

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Friendly addresses for the admin guide, in both languages:
    #   /admin/help and /admin/pomoc  ->  /admin.php?tab=help
    #
    # A REDIRECT, not an internal rewrite, and that is the whole point. Serving
    # admin.php AT the path /admin/help would leave the browser resolving every
    # relative asset ("templates/light/css/style.css", "js/scripts.js", the
    # thumbnails) against /admin/ — so the page would arrive completely
    # unstyled. See the note at the top of this file. Bouncing the browser to
    # the real single-segment URL sidesteps that entirely: what finally renders
    # is an ordinary /admin.php request.
    #
    # 302 rather than 301: a permanent redirect is cached by browsers for a
    # long time and is awkward to take back, and this is a convenience alias
    # rather than a promise about where the page lives.
    #
    # WHY THE TARGET IS BUILT FROM REQUEST_URI rather than written as a plain
    # "admin.php?tab=help": with the R flag, a relative substitution is resolved
    # against the FILESYSTEM, and the server's real directory path ends up in
    # the Location header — a browser gets sent to /home/user/public_html/
    # admin.php. Taking the part of the request BEFORE /admin gives a
    # root-relative target instead, which is correct both at the web root and
    # for a club installed in a subfolder (/zapisy/admin/help -> /zapisy/
    # admin.php?tab=help). A hardcoded leading slash would fix the first case
    # and break the second.
    RewriteCond %{REQUEST_URI} ^(.*)/admin/(help|pomoc)/?$ [NC]
    RewriteRule ^ %1/admin.php?tab=help [R=302,L]

    # Map /name -> name.php.
    #   !-f / !-d : never shadow something that already exists, so a real file or
    #               directory keeps winning (e.g. /icons stays the icons folder).
    #   .php -f   : only rewrite when the target script actually exists, so an
    #               unknown path still gives an honest 404 rather than a PHP error.
    #   [^/]+     : one segment, no slashes — see the note above about relative URLs.
    # The original query string is carried over, so /admin?tab=options works.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)$ $1.php [L,QSA]

    # Belt and braces for the database. The installer already drops a
    # "Require all denied" .htaccess into data/, but it writes it with @ — a
    # failure there is silent, and that directory holds database.sqlite. This
    # rule doesn't depend on that file having been written, and unlike
    # "Require all denied" it behaves the same on Apache 2.2 and 2.4.
    RewriteRule ^data(/|$) - [F,L]

    # The admin guide is rendered by the Help tab, which is behind a login.
    # The files themselves are plain Markdown, so without this they would also
    # be readable by anyone who guessed the path — harmless in content, but
    # there is no reason to serve a club's admin instructions to the public.
    RewriteRule ^help(/|$) - [F,L]
</IfModule>
